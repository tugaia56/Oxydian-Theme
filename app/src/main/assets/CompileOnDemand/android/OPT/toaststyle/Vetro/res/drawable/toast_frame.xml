<?xml version="1.0" encoding="utf-8"?>
<!-- Stile toast del Theme (stessi preset del modulo Oxydian) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@*android:color/accent_material_dark" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <gradient android:type="linear" android:angle="315" android:startColor="#00000000" android:endColor="#4D000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="#99FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
