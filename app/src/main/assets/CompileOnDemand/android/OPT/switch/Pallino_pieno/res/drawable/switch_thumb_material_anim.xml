<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@*android:integer/config_mediumAnimTime"
    android:exitFadeDuration="@*android:integer/config_mediumAnimTime">
    <item android:state_enabled="false">
        <shape android:shape="oval" android:useLevel="false">
            <size android:width="21.0dip" android:height="21.0dip" />
            <solid android:color="#11FFFFFF" />
            <stroke android:width="1.5dip" android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="oval" android:useLevel="false">
            <size android:width="21.0dip" android:height="21.0dip" />
            <solid android:color="#908dff" />
            <stroke android:width="1.5dip" android:color="#908dff" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="oval" android:useLevel="false">
            <size android:width="21.0dip" android:height="21.0dip" />
            <solid android:color="#99ffffff" />
            <stroke android:width="1.5dip" android:color="#99ffffff" />
        </shape>
    </item>
</selector>
