<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@*android:integer/config_mediumAnimTime"
    android:exitFadeDuration="@*android:integer/config_mediumAnimTime">
    <item android:state_checked="true">
        <shape android:shape="oval" android:useLevel="false">
            <solid android:color="#59908dff" />
            <size android:width="21.0dip" android:height="21.0dip" />
            <stroke android:width="1.0dip" android:color="?android:attr/colorAccent" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="oval" android:useLevel="false">
            <size android:width="21.0dip" android:height="21.0dip" />
            <solid android:color="#59908dff" />
            <stroke android:width="1.0dip" android:color="?android:attr/colorControlNormal" />
        </shape>
    </item>
</selector>
