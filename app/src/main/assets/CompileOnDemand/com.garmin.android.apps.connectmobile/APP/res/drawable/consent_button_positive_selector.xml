<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@*android:color/accent_material_dark" />
            <corners
                android:radius="2.500000dp" />
        </shape>
    </item>
    <item
        android:state_enabled="false">
        <shape
            android:shape="rectangle">
            <solid
                android:color="#4d908dff" />
            <corners
                android:radius="2.500000dp" />
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="@*android:color/accent_material_dark" />
            <corners
                android:radius="2.500000dp" />
        </shape>
    </item>
</selector>
