<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
    <layer-list>
        <item android:width="60dp" android:height="60dp" android:gravity="center">
            <shape android:shape="oval">
                <solid android:color="@*android:color/background_dark" />
                <stroke android:width="1.5dp" android:color="@*android:color/accent_material_dark" />
            </shape>
        </item>
        <item android:width="22dp" android:height="22dp" android:gravity="center">
            <shape android:shape="oval"><solid android:color="@*android:color/car_cyan_400" /></shape>
        </item>
    </layer-list>
    </item>
