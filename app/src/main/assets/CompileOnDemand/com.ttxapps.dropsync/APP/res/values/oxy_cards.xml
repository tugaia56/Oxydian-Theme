<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="cardBackgroundColor" format="reference|color" />
    <attr name="cardElevation" format="dimension" />
    <attr name="shapeAppearance" format="reference" />
    <attr name="strokeWidth" format="dimension" />
    <attr name="strokeColor" format="reference|color" />
    <attr name="colorSurfaceContainerLow" format="reference|color" />
    <attr name="shapeAppearanceCornerMedium" format="reference" />

    <!-- card dell'app (MaterialCardView, stile Elevated): stesse impostazioni dell'originale piu' il bordo accento di 1 dp -->
    <style name="Widget.Material3.CardView.Elevated" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">1.0dip</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerMedium</item>
        <item name="strokeWidth">1.0dip</item>
        <item name="strokeColor">@*android:color/accent_material_dark</item>
    </style>
</resources>
