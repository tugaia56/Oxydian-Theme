<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="cardNormalBackgroundColor" format="reference|color" />
    <dimen name="card_horizontal_padding">16.0dip</dimen>
    <dimen name="card_vertical_padding">8.0dip</dimen>

    <!-- contenuto delle card: stesso stile dell'app, piu' il bordo accento come primo piano (l'app cambia lo sfondo da codice).
         abc_ratingbar_small_material e' un disegno non usato dall'app, qui riutilizzato come bordo. -->
    <style name="Widget.MyTheme.CardContent" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/abc_ratingbar_material</item>
        <item name="android:foreground">@drawable/abc_ratingbar_small_material</item>
        <item name="android:paddingTop">@dimen/card_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/card_vertical_padding</item>
        <item name="android:paddingStart">@dimen/card_horizontal_padding</item>
        <item name="android:paddingEnd">@dimen/card_horizontal_padding</item>
    </style>
</resources>
