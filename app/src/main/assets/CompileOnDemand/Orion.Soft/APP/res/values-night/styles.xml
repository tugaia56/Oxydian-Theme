<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dialog dell'app: nel codice usano Theme.MiTemaDialogoLight / Dark (dialog di sistema, senza altri attributi).
         In modalita' notte si usa il dialog scuro nativo e lo sfondo e' il colore "flottante" scuro del tema scelto in Oxydian Theme. -->
    <style name="Theme.MiTemaDialogoLight" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:colorBackground">@*android:color/background_floating_material_dark</item>
    </style>
    <style name="Theme.MiTemaDialogoDark" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:colorBackground">@*android:color/background_floating_material_dark</item>
    </style>
</resources>
