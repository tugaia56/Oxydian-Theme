<?xml version="1.0" encoding="utf-8"?>
<!-- Bordo spesso (stile del modulo Oxydian, come overlay). Strato 1 vuoto: ci mette la tinta il sistema -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="@*android:color/system_background_dark" />
                <stroke android:width="4dp" android:color="@*android:color/accent_material_dark" />
                <corners android:radius="24dp" />
            </shape>
    </item>
    <item>
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="#00000000" />
                <corners android:radius="24dp" />
            </shape>
    </item>
    <item>
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="@*android:color/system_background_dark" />
                <stroke android:width="4dp" android:color="@*android:color/accent_material_dark" />
                <corners android:radius="24dp" />
            </shape>
    </item>
</layer-list>
