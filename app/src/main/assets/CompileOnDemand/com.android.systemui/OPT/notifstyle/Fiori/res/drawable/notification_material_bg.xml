<?xml version="1.0" encoding="utf-8"?>
<!-- Fiori (stile del modulo Oxydian, come overlay). Strato 1 vuoto: ci mette la tinta il sistema -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="@*android:color/system_background_dark" />
                <corners android:radius="24dp" />
            </shape>
    </item>
    <item>
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="#00000000" />
                <corners android:radius="24dp" />
            </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
            <bitmap xmlns:android="http://schemas.android.com/apk/res/android" android:src="@drawable/oxy_tex_clubs" android:tileMode="repeat" android:tint="@*android:color/accent_material_dark" />
    </item>
</layer-list>
