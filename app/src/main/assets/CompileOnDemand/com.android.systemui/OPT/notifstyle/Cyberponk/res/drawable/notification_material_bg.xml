<?xml version="1.0" encoding="utf-8"?>
<!-- Cyberponk (stile del modulo Oxydian, come overlay). Strato 1 vuoto: ci mette la tinta il sistema -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="@*android:color/system_background_dark" />
                <corners android:radius="24dp" />
            </shape>
    </item>
    <item>
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="#00000000" />
                <corners android:radius="24dp" />
            </shape>
    </item>
    <item android:width="84dp" android:height="3dp" android:gravity="top|end" android:top="6dp" android:end="6dp">
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="@*android:color/accent_material_dark" />
                <corners android:radius="1dp" />
            </shape>
    </item>
    <item android:width="84dp" android:height="3dp" android:gravity="bottom|end" android:bottom="6dp" android:end="6dp">
            <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                <solid android:color="@*android:color/accent_material_dark" />
                <corners android:radius="1dp" />
            </shape>
    </item>
</layer-list>
